# Safe local-development placeholders only. Copy this file to `.env` and replace
# every value marked `change-me`. Never use these values in a shared environment.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

APPOINTMENTCRM_POSTGRES_DB=appointment_crm
APPOINTMENTCRM_POSTGRES_USER=appointment_crm
APPOINTMENTCRM_POSTGRES_PASSWORD=change-me-local-only
APPOINTMENTCRM_POSTGRES_PORT=5432
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=appointment_crm;Username=appointment_crm;Password=change-me-local-only

ConnectionStrings__Redis=redis:6379
APPOINTMENTCRM_REDIS_PORT=6379
APPOINTMENTCRM_API_PORT=8080
APPOINTMENTCRM_WEB_PORT=5173

Identity__AccessTokenMinutes=10
Identity__RefreshTokenDays=30
Identity__RefreshCookieName=appointment_crm_refresh
Identity__LoginPermitLimit=30
Identity__RefreshPermitLimit=30
APPOINTMENTCRM_SECURE_COOKIE=false

APPOINTMENTCRM_DEMO_SEED_ENABLED=true
APPOINTMENTCRM_DEMO_PASSWORD=Demo-local-2026!

Cors__AllowedOrigins__0=http://localhost:5173

OTEL_SERVICE_NAME=appointment-crm-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Production/staging values intentionally live in an external runtime.env and
# secret directory. See deploy/environments/*.env.example and the deployment runbook.
