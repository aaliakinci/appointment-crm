{
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=appointment_crm;Username=appointment_crm;Password=change-me-local-only",
    "Redis": "127.0.0.1:6379,abortConnect=false,connectTimeout=1000,syncTimeout=1000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Identity": {
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "RefreshCookieName": "appointment_crm_refresh",
    "RequireSecureCookie": true,
    "LoginPermitLimit": 30,
    "RefreshPermitLimit": 30
  },
  "DemoSeed": {
    "Enabled": false,
    "Password": ""
  },
  "DataProtection": {
    "UseEphemeralKeys": false
  },
  "DashboardCache": {
    "Enabled": true,
    "TimeToLiveSeconds": 30,
    "KeyPrefix": "appointment-crm:"
  },
  "Outbox": {
    "WorkerEnabled": true,
    "BatchSize": 20,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 30,
    "MaximumAttempts": 5,
    "BaseRetryDelaySeconds": 2,
    "MaximumRetryDelaySeconds": 300
  },
  "Security": {
    "MaximumRequestBodyBytes": 1048576,
    "WritePermitLimit": 120,
    "WriteWindowSeconds": 60,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": ""
    }
  },
  "AllowedHosts": "*"
}
